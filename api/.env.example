NODE_ENV=development
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
AUTH_MODE=disabled

# PostgreSQL / PostGIS (Docker Compose defaults — see api/docker-compose.yml)
POSTGRES_USER=sesh
POSTGRES_PASSWORD=sesh
POSTGRES_DB=sesh
POSTGRES_PORT=5433

# Application + drizzle-kit connection strings
DATABASE_URL=postgres://sesh:sesh@127.0.0.1:5433/sesh
DATABASE_URL_TEST=postgres://sesh:sesh@127.0.0.1:5433/sesh_test
